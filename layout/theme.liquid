<!doctype html>
{% liquid
  assign locale_code = request.locale.iso_code | default: 'en'
  assign is_rtl = false
  assign request_is_ar = false
  if request.locale.iso_code contains 'ar'
    assign request_is_ar = true
  endif
  assign is_arabic_funnel_page = false
  if template.name == 'page' and page.handle == 'launchedge™-من-صفر-إلى-دخل-حقيقي'
    assign is_arabic_funnel_page = true
    assign locale_code = 'ar'
  endif
  if locale_code contains 'ar'
    assign is_rtl = true
  endif

  assign canonical_brand = 'DigitalSupply Co'
  assign meta_description = page_description
  assign seo_title = page_title
  if template.name == 'index'
    assign seo_title = 'DigitalSupply Co — Step-by-Step Online Income Systems (Arabic + English)'
    assign meta_description = 'Practical digital systems for Amazon FBA, dropshipping, and online income, with instant access in Arabic and English and a 30-day money-back guarantee.'
    if request_is_ar
      assign seo_title = 'DigitalSupply Co — أنظمة رقمية عملية بالعربية والإنجليزية'
      assign meta_description = 'أنظمة رقمية عملية لمسارات Amazon FBA والدروبشيبينغ والدخل الأونلاين، مع وصول فوري بالعربية والإنجليزية وضمان استرداد لمدة 30 يوماً.'
    endif
  elsif template.name == 'product'
    assign seo_title = product.title
    case product.handle
      when 'amazon-fba-blueprint'
        assign meta_description = 'Plan an Amazon FBA business with a practical digital guide to product validation, suppliers, listing preparation, launch planning, and PPC basics.'
        if request_is_ar
          assign seo_title = 'Amazon FBA — ابنِ مشروع بيع على أمازون'
          assign meta_description = 'دليل رقمي عملي لتخطيط مشروع Amazon FBA والتحقق من المنتجات والموردين وتجهيز صفحة المنتج وخطة الإطلاق وأساسيات PPC.'
        endif
      when 'dropshipping-mastery-system'
        assign meta_description = 'Build a structured dropshipping launch plan covering product research, supplier checks, store readiness, product pages, and offer testing.'
        if request_is_ar
          assign seo_title = 'دروبشيبينغ — ابدأ متجر بدون مخزون'
          assign meta_description = 'دليل رقمي عملي لبناء خطة دروبشيبينغ تشمل بحث المنتجات وفحص الموردين وتجهيز المتجر وصفحات المنتجات واختبار العروض.'
        endif
      when 'online-income-system'
        assign meta_description = 'Choose a focused online offer and organize the assets, messages, content, and repeatable workflows needed to start applying it.'
        if request_is_ar
          assign seo_title = 'AI Income System — ابدأ مسار دخل رقمي'
          assign meta_description = 'نظام رقمي للمبتدئين لاختيار عرض واضح وتنظيم الأصول والرسائل والمحتوى وخطوات العمل القابلة للتكرار.'
        endif
      else
        assign meta_description = product.description | strip_html | strip_newlines | truncatewords: 24
    endcase
  endif
%}
<html class="no-js" lang="{{ locale_code }}" dir="{% if is_rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#000000">
    {% if template.name == 'collection' and collection.handle == 'frontpage' %}
      <link rel="canonical" href="{{ shop.url }}{{ routes.all_products_collection_url }}">
      <meta name="robots" content="noindex,follow">
    {% else %}
      <link rel="canonical" href="{{ canonical_url }}">
    {% endif %}
    {% if template.name == 'product' and product.handle == 'shipping-protection' %}
      <meta name="robots" content="noindex,nofollow">
    {% endif %}
    {% if is_arabic_funnel_page and request_is_ar == false %}
      <meta name="robots" content="noindex,follow">
    {% endif %}
    <link rel="icon" href="{{ 'favicon.ico' | asset_url }}&favicon=20260705" sizes="any">
    <link rel="shortcut icon" href="{{ 'favicon.ico' | asset_url }}&favicon=20260705">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-16x16.png' | asset_url }}&favicon=20260705">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32x32.png' | asset_url }}&favicon=20260705">
    <link rel="icon" type="image/png" sizes="48x48" href="{{ 'favicon-48x48.png' | asset_url }}&favicon=20260705">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}&favicon=20260705">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ 'android-chrome-192x192.png' | asset_url }}&favicon=20260705">
    <link rel="icon" type="image/png" sizes="512x512" href="{{ 'android-chrome-512x512.png' | asset_url }}&favicon=20260705">
    <link rel="manifest" href="{{ 'site.webmanifest' | asset_url }}&favicon=20260705">
    <meta name="msapplication-TileColor" content="#1D1D1F">
    <meta name="msapplication-TileImage" content="{{ 'android-chrome-192x192.png' | asset_url }}&favicon=20260705">

    {% if settings.support_email != blank %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": {{ canonical_brand | json }},
          "url": {{ shop.url | json }},
          "email": {{ settings.support_email | json }},
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "customer support",
            "email": {{ settings.support_email | json }}
          }
        }
      </script>
    {% endif %}

    {% if template.name == 'index' %}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "WebSite",
          "name": {{ canonical_brand | json }},
          "url": {{ shop.url | json }},
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              {%- capture search_url_template -%}{{ shop.url }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}
              "urlTemplate": {{ search_url_template | json }}
            },
            "query-input": "required name=search_term_string"
          }
        }
      </script>
    {% endif %}

    <title>
      {{ seo_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.pagination.page' | t: number: current_page }}{% endif -%}
      {%- unless template.name == 'index' or page_title contains canonical_brand %} &ndash; {{ canonical_brand }}{% endunless -%}
    </title>

    {% if meta_description != blank %}
      <meta name="description" content="{{ meta_description | escape }}">
    {% endif %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://db.onlinewebfonts.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;700&amp;family=Inter:wght@400;500;600;700&amp;display=swap">

    {%- comment -%} Retro dot-matrix display face used for headlines and stat glyphs. {%- endcomment -%}
    <link rel="stylesheet" href="https://db.onlinewebfonts.com/c/8cb707a9b8a73f8a7403336b861c3074?family=BubbledotICG-FinePos">

    {%- comment -%} Brand + UI glyphs. {%- endcomment -%}
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
      integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer">

    {{ content_for_header }}

    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name | handle }}{% if is_rtl %} rtl{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% section 'header' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
  </body>
</html>
