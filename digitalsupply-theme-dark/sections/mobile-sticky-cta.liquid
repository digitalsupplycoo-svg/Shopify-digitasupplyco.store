{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif

  assign amazon_product = all_products['amazon-fba-blueprint']
  assign dropshipping_product = all_products['dropshipping-mastery-system']
  assign ai_product = all_products['online-income-system']
  assign discount_percent = 20
  assign amazon_price = 2999
  assign dropshipping_price = 2999
  assign ai_price = 2999
  assign bundle_url = '#bundle'
  assign bundle_variant_ids = ''

  if amazon_product != blank
    assign amazon_variant = amazon_product.selected_or_first_available_variant
    assign amazon_price = amazon_product.price
  endif
  if dropshipping_product != blank
    assign dropshipping_variant = dropshipping_product.selected_or_first_available_variant
    assign dropshipping_price = dropshipping_product.price
  endif
  if ai_product != blank
    assign ai_variant = ai_product.selected_or_first_available_variant
    assign ai_price = ai_product.price
  endif

  assign bundle_original = amazon_price | plus: dropshipping_price | plus: ai_price
  assign bundle_savings = bundle_original | times: discount_percent | divided_by: 100
  assign bundle_final = bundle_original | minus: bundle_savings

  if amazon_variant != blank
    if dropshipping_variant != blank
      if ai_variant != blank
        assign bundle_variant_ids = amazon_variant.id | append: ',' | append: dropshipping_variant.id | append: ',' | append: ai_variant.id
        assign bundle_path = '/cart/'
        assign bundle_path = bundle_path | append: amazon_variant.id | append: ':1,'
        assign bundle_path = bundle_path | append: dropshipping_variant.id | append: ':1,'
        assign bundle_path = bundle_path | append: ai_variant.id | append: ':1'
        assign encoded_bundle_path = bundle_path | url_encode
        assign bundle_url = routes.root_url | append: 'discount/BUNDLE20?redirect=' | append: encoded_bundle_path
      endif
    endif
  endif
%}

<div class="mobile-sticky-cta" data-mobile-sticky-cta>
  <strong>{% if is_ar %}الأنظمة الثلاثة · {{ bundle_final | money }}{% else %}All 3 systems · {{ bundle_final | money }}{% endif %}</strong>
  <a
    href="{{ bundle_url }}"
    {% if bundle_variant_ids != blank %}
      data-bundle-add-trigger
      data-bundle-variant-ids="{{ bundle_variant_ids }}"
      data-bundle-cart-url="{{ routes.cart_url }}.js"
      data-bundle-add-url="{{ routes.cart_add_url }}.js"
      data-bundle-loading="{% if is_ar %}جاري التجهيز...{% else %}Preparing...{% endif %}"
      data-bundle-error="{% if is_ar %}تعذر تجهيز الباقة. افتحي السلة وحاولي مرة ثانية.{% else %}We could not prepare the bundle. Please open cart and try again.{% endif %}"
    {% endif %}
  >
    {% if is_ar %}خذ الباقة{% else %}Get Bundle{% endif %}
  </a>
</div>

{% stylesheet %}
  .mobile-sticky-cta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 120;
    padding: 12px 16px;
    display: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    background: var(--color-surface);
    border-top: 1px solid rgba(16, 36, 62, 0.12);
    box-shadow: 0 -14px 34px rgba(16, 36, 62, 0.16);
  }

  .mobile-sticky-cta.is-visible {
    display: flex;
  }

  .mobile-sticky-cta strong {
    color: #10243E;
    font-size: 0.92rem;
    line-height: 1.25;
  }

  .mobile-sticky-cta a {
    min-height: 44px;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: #E8A020;
    border-radius: 12px;
    font-family: var(--heading);
    font-weight: 900;
    white-space: nowrap;
  }

  @media (min-width: 769px) {
    .mobile-sticky-cta {
      display: none !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var bar = document.querySelector('[data-mobile-sticky-cta]');
    if (!bar) return;
    function update() {
      if (window.innerWidth > 768) {
        bar.classList.remove('is-visible');
        return;
      }
      bar.classList.toggle('is-visible', window.scrollY > 200);
    }
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Mobile sticky CTA",
  "presets": [{ "name": "Mobile sticky CTA" }]
}
{% endschema %}
