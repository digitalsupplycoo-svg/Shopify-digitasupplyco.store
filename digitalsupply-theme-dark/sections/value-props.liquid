{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif

  assign heading = section.settings.heading_en
  assign text = section.settings.text_en
  if is_ar
    assign heading = section.settings.heading_ar | default: heading
    assign text = section.settings.text_ar | default: text
  endif
%}

<section class="inside-section value-section">
  <div class="section-heading">
    <h2>{{ heading }}</h2>
    {% if text != blank %}<p>{{ text }}</p>{% endif %}
  </div>

  <div class="value-grid">
    {% for block in section.blocks %}
      {% liquid
        assign title = block.settings.title_en
        assign body = block.settings.text_en
        if is_ar
          assign title = block.settings.title_ar | default: title
          assign body = block.settings.text_ar | default: body
        endif
      %}
      <article class="value-card" {{ block.shopify_attributes }}>
        <span>{{ block.settings.badge }}</span>
        <h3>{{ title }}</h3>
        <p>{{ body }}</p>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Value propositions",
  "settings": [
    {
      "type": "text",
      "id": "heading_en",
      "label": "Heading - English",
      "default": "Why choose DigitalSupply Co"
    },
    {
      "type": "text",
      "id": "heading_ar",
      "label": "Heading - Arabic",
      "default": "لماذا تختار DigitalSupply Co؟"
    },
    {
      "type": "textarea",
      "id": "text_en",
      "label": "Text - English",
      "default": "A focused store for practical digital systems: clear steps, instant delivery, bilingual support, and a safer buying experience."
    },
    {
      "type": "textarea",
      "id": "text_ar",
      "label": "Text - Arabic",
      "default": "متجر متخصص في أنظمة رقمية عملية: خطوات واضحة، تحميل فوري، دعم عربي/إنجليزي، وتجربة شراء موثوقة."
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value card",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge", "default": "01" },
        { "type": "text", "id": "title_en", "label": "Title - English", "default": "Instant digital access" },
        { "type": "textarea", "id": "text_en", "label": "Text - English", "default": "Your files are delivered digitally after checkout, so customers can start learning immediately." },
