{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif

  assign eyebrow = section.settings.eyebrow_en
  assign heading = section.settings.heading_en
  assign intro = section.settings.intro_en
  assign score = section.settings.score_en
  assign score_label = section.settings.score_label_en
  assign metric_1 = section.settings.metric_1_en
  assign metric_2 = section.settings.metric_2_en
  assign metric_3 = section.settings.metric_3_en
  assign footer_text = section.settings.footer_text_en

  if is_ar
    assign eyebrow = section.settings.eyebrow_ar | default: eyebrow
    assign heading = section.settings.heading_ar | default: heading
    assign intro = section.settings.intro_ar | default: intro
    assign score = section.settings.score_ar | default: score
    assign score_label = section.settings.score_label_ar | default: score_label
    assign metric_1 = section.settings.metric_1_ar | default: metric_1
    assign metric_2 = section.settings.metric_2_ar | default: metric_2
    assign metric_3 = section.settings.metric_3_ar | default: metric_3
    assign footer_text = section.settings.footer_text_ar | default: footer_text
  endif

  if is_ar
    if eyebrow contains 'تقييم'
      assign eyebrow = 'ثقة مبنية على الوضوح'
    endif
    if heading contains 'تقييم'
      assign heading = 'اشتري وأنت فاهم بالضبط ماذا ستحصل عليه.'
    endif
    if intro contains 'تقييم'
      assign intro = 'DigitalSupply Co يوضح لك محتوى المنتج، طريقة الاستخدام، التسليم الفوري، وضمان 30 يوم حتى يكون قرارك مبنياً على وضوح وثقة.'
    endif
    if footer_text contains 'تقييم'
      assign footer_text = 'عند توفر آراء حقيقية من المشترين يمكن إضافتها لاحقاً من محرر الثيم. حالياً نركز على الوضوح، التسليم الفوري، والضمان بدل أي كلام غير موثق.'
    endif
  else
    if eyebrow contains 'Review'
      assign eyebrow = 'Trust built on clarity'
    endif
    if eyebrow contains 'review'
      assign eyebrow = 'Trust built on clarity'
    endif
    if heading contains 'Review'
      assign heading = 'Buy with a clear view of what you receive.'
    endif
    if heading contains 'review'
      assign heading = 'Buy with a clear view of what you receive.'
    endif
    if intro contains 'review'
      assign intro = 'DigitalSupply Co keeps the offer clear before checkout: what is inside, how delivery works, the refund window, and the practical value of each product.'
    endif
    if footer_text contains 'review'
      assign footer_text = ''
    endif
  endif

  if is_ar
    assign plan_eyebrow = 'خطة تنفيذ خلال 3 أيام'
    assign plan_intro = 'لا تشتري ملفاً وتتركه. ابدأ بخطة تنفيذ بسيطة تحوّل النظام إلى قرارات وخطوة عملية أولى.'
    assign day_1_title = 'افهم الطريق'
    assign day_1_text = 'راجع الخريطة وحدد ما يناسب ميزانيتك ووقتك واحذف الخيارات التي لا تناسب مرحلتك الحالية.'
    assign day_2_title = 'اختر اتجاه واحد'
    assign day_2_text = 'قارن الأفكار أو المنتجات أو نماذج الدخل، ثم اختر الاتجاه الذي يملك أوضح خطوة تالية.'
    assign day_3_title = 'نفّذ أول خطوة'
    assign day_3_text = 'حوّل التعلم إلى خطوة حقيقية: قائمة منتجات، عرض أولي، اختبار سوق، أو تجهيز خطوة المتجر التالية.'
    assign value_eyebrow = 'إطار قيمة 10x'
    assign value_text = 'المقصود أن الأنظمة مصممة لتعطيك قيمة عملية عبر اختصار وقت البحث، تنظيم القرار، ومساعدتك على تجنّب أخطاء البداية.'
    assign bundle_title = 'لماذا باقة الثلاث أنظمة منطقية؟'
    assign bundle_text = 'كل منتج يغطي زاوية مختلفة من طريق الدخل الرقمي. عند شراء الثلاثة معاً تحصل على الصورة الأوسع مقابل $71.98 بدل $89.97، وتوفر $17.99 تلقائياً عند الدفع بدون الحاجة لكتابة كود.'
  else
    assign plan_eyebrow = '3-day action plan'
    assign plan_intro = 'Do not just download and forget it. Start with a simple execution path that turns the system into decisions and a first real action.'
    assign day_1_title = 'Understand the path'
    assign day_1_text = 'Read the roadmap, mark what fits your budget and time, and remove options that do not fit your current stage.'
    assign day_2_title = 'Choose one direction'
    assign day_2_text = 'Compare ideas, products, or income models, then choose the direction with the clearest next step.'
    assign day_3_title = 'Take the first action'
    assign day_3_text = 'Turn learning into one move: a product shortlist, offer outline, niche check, or next store step.'
    assign value_eyebrow = '10x Value Framework'
    assign value_text = 'This is not a guaranteed profit promise. It means the systems are built to deliver more value than their price by saving research time, organizing decisions, and helping you avoid beginner mistakes.'
    assign bundle_title = 'Why the 3-system bundle makes sense'
    assign bundle_text = 'Each product covers a different part of the online income path. Buying all three gives you the wider picture for $71.98 instead of $89.97, saving $17.99 automatically at checkout with no code typing.'
  endif
%}

{{ 'customer-reviews.css' | asset_url | stylesheet_tag }}

<section class="review-proof" aria-label="{{ heading | escape }}">
  <div class="review-proof__summary">
    <div>
      {% if eyebrow != blank %}
        <p class="eyebrow">{{ eyebrow }}</p>
      {% endif %}
      <h2>{{ heading }}</h2>
      {% if intro != blank %}
        <p>{{ intro }}</p>
      {% endif %}
    </div>

    <aside class="review-score" aria-label="{{ score_label | escape }}">
      <strong>{{ score }}</strong>
      <p>{{ score_label }}</p>
    </aside>
  </div>

  <div class="review-metrics" aria-label="{{ heading | escape }}">
    {% if metric_1 != blank %}<span>{{ metric_1 }}</span>{% endif %}
    {% if metric_2 != blank %}<span>{{ metric_2 }}</span>{% endif %}
    {% if metric_3 != blank %}<span>{{ metric_3 }}</span>{% endif %}
  </div>

  <div class="review-card-grid">
    {% for block in section.blocks %}
      {% liquid
        assign title = block.settings.title_en
        assign text = block.settings.quote_en
        assign author = block.settings.author_en
        assign meta = block.settings.meta_en
        if is_ar
          assign title = block.settings.title_ar | default: title
          assign text = block.settings.quote_ar | default: text
          assign author = block.settings.author_ar | default: author
          assign meta = block.settings.meta_ar | default: meta
        endif
        assign text = text | replace: 'ف٪ح', 'فتح'
        if is_ar
          if meta contains 'تقييم'
            assign meta = 'نقطة ثقة'
          endif
          if author contains 'تقييم'
            assign author = 'سبب يطمئن المشتري'
          endif
        else
          if meta contains 'review'
            assign meta = 'Trust note'
          endif
          if author contains 'review'
            assign author = 'Buyer confidence point'
          endif
        endif
      %}

      <article class="review-card" {{ block.shopify_attributes }}>
        {% if title != blank %}<h3>{{ title }}</h3>{% endif %}
        {% if text != blank %}<p>{{ text }}</p>{% endif %}
        {% if author != blank or meta != blank %}
          <footer>
            {% if author != blank %}<strong>{{ author }}</strong>{% endif %}
            {% if meta != blank %}<span>{{ meta }}</span>{% endif %}
          </footer>
        {% endif %}
      </article>
    {% endfor %}
  </div>

  {% if footer_text != blank %}
    <p class="review-proof__footer">{{ footer_text }}</p>
  {% endif %}

  <div class="trust-conversion">
    <article class="trust-conversion__panel">
      <p class="eyebrow">{{ plan_eyebrow }}</p>
      <h3>{{ plan_intro }}</h3>
      <div class="trust-plan">
        <div><strong>01</strong><h4>{{ day_1_title }}</h4><p>{{ day_1_text }}</p></div>
        <div><strong>02</strong><h4>{{ day_2_title }}</h4><p>{{ day_2_text }}</p></div>
        <div><strong>03</strong><h4>{{ day_3_title }}</h4><p>{{ day_3_text }}</p></div>
      </div>
    </article>

    <article class="trust-conversion__panel trust-conversion__panel--dark">
      <p class="eyebrow">{{ value_eyebrow }}</p>
      <h3>{{ value_text }}</h3>
      <div class="bundle-note">
        <strong>{{ bundle_title }}</strong>
        <p>{{ bundle_text }}</p>
      </div>
    </article>
  </div>
</section>

