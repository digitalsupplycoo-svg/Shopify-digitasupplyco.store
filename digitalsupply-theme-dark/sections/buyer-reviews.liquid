{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif
%}

<section class="buyer-reviews" aria-label="{% if is_ar %}تفاصيل يمكن التحقق منها قبل الشراء{% else %}Details to verify before purchase{% endif %}">
  <h2>{% if is_ar %}تفاصيل واضحة قبل الشراء{% else %}Clear details before purchase{% endif %}</h2>
  <div class="buyer-reviews__grid">
    {% for block in section.blocks %}
      {% liquid
        assign text = block.settings.text_en
        assign name = block.settings.name_en
        assign country = block.settings.country_en
        if is_ar
          assign text = block.settings.text_ar | default: text
          assign name = block.settings.name_ar | default: name
          assign country = block.settings.country_ar | default: country
        endif
      %}
      <article class="buyer-review-card" {{ block.shopify_attributes }}>
        <p>{{ text }}</p>
        <footer>
          <strong>{{ name }}</strong>
          <span>{{ country }}</span>
          <small>{% if is_ar %}تفصيل من المتجر{% else %}Store detail{% endif %}</small>
        </footer>
      </article>
    {% endfor %}
  </div>
  <p class="buyer-reviews__join">{% if is_ar %}ستتم إضافة تقييمات المشترين فقط بعد جمع آراء حقيقية وموثقة.{% else %}Buyer reviews will be added only after genuine, verified feedback is collected.{% endif %}</p>
</section>

{% stylesheet %}
  .buyer-reviews {
    width: min(var(--page-width), calc(100vw - 2rem));
    margin: 4rem auto;
  }

  .buyer-reviews h2 {
    margin: 0 0 1.3rem;
    font-family: var(--heading);
    font-size: clamp(2.6rem, 6vw, 5.2rem);
    line-height: 0.92;
    text-transform: uppercase;
    text-align: center;
  }

  .buyer-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .buyer-review-card {
    padding: 1.2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    box-shadow: 6px 6px 0 rgba(16, 36, 62, 0.08);
  }

  .buyer-review-card__stars {
    margin: 0 0 0.75rem;
    color: #E8A020;
    letter-spacing: 0.08em;
  }

  .buyer-review-card > p {
    margin: 0;
    color: var(--color-ink);
    font-size: 1.08rem;
    line-height: 1.55;
  }

  .buyer-review-card footer {
    margin-top: 1rem;
    display: grid;
    gap: 0.2rem;
  }

  .buyer-review-card small {
    width: max-content;
    padding: 0.25rem 0.45rem;
    color: #fff;
    background: #123A6B;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 900;
  }

  .buyer-reviews__join {
    margin: 1.25rem 0 0;
    text-align: center;
    font-weight: 900;
  }

  @media (max-width: 800px) {
    .buyer-reviews__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Buyer information",
  "blocks": [
    {
      "type": "review",
      "name": "Trust detail",
      "settings": [
        { "type": "textarea", "id": "text_en", "label": "Proof text - English", "default": "Instant digital access after checkout with no shipping wait." },
        { "type": "textarea", "id": "text_ar", "label": "Proof text - Arabic", "default": "وصول رقمي فوري بعد الدفع بدون انتظار الشحن." },
        { "type": "text", "id": "name_en", "label": "Label - English", "default": "Trust point" },
        { "type": "text", "id": "name_ar", "label": "Label - Arabic", "default": "نقطة ثقة" },
        { "type": "text", "id": "country_en", "label": "Meta - English", "default": "Digital delivery" },
        { "type": "text", "id": "country_ar", "label": "Meta - Arabic", "default": "تسليم رقمي" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Buyer information",
      "blocks": [
        { "type": "review", "settings": { "text_ar": "وصول رقمي فوري بعد الدفع بدون انتظار الشحن.", "text_en": "Instant digital access after checkout with no shipping wait.", "name_en": "Trust point", "name_ar": "نقطة ثقة", "country_en": "Digital delivery", "country_ar": "تسليم رقمي" } },
        { "type": "review", "settings": { "text_en": "Arabic and English support makes the store easier to understand.", "text_ar": "دعم العربية والإنجليزية يجعل تجربة المتجر أوضح.", "name_en": "Language support", "name_ar": "دعم اللغة", "country_en": "Arabic + English", "country_ar": "عربي + إنجليزي" } },
        { "type": "review", "settings": { "text_ar": "الخصم يطبق من مسار الباقة حتى لا يحتاج العميل كتابة الكود يدوياً.", "text_en": "The bundle route applies the saving so customers do not need to type the code manually.", "name_en": "Bundle saving", "name_ar": "توفير الباقة", "country_en": "Automatic discount path", "country_ar": "مسار خصم تلقائي" } }
      ]
    }
  ]
}
{% endschema %}
