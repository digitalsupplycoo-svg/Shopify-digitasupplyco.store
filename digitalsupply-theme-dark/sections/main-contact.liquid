<section class="page-wrap contact-page">
  {% render 'breadcrumbs' %}
  <h1>{{ page.title }}</h1>

  {% if page.content != blank %}
    <div class="rte">{{ page.content }}</div>
  {% endif %}

  {% if settings.support_email != blank %}
    <div class="contact-page__direct">
      <p>{{ 'contact.prefer_email' | t }}</p>
      <a href="mailto:{{ settings.support_email | escape }}">{{ settings.support_email }}</a>
      <p class="contact-page__reply">{{ 'contact.reply_time' | t }}</p>
    </div>
  {% endif %}

  {% form 'contact', class: 'customer-form contact-page__form' %}
    {% if form.posted_successfully? %}
      <p role="status">{{ 'contact.success' | t }}</p>
    {% endif %}
    {{ form.errors | default_errors }}

    <label for="ContactName">{{ 'contact.name' | t }}</label>
    <input id="ContactName" type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">

    <label for="ContactEmail">{{ 'contact.email' | t }}</label>
    <input id="ContactEmail" type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>

    <label for="ContactMessage">{{ 'contact.message' | t }}</label>
    <textarea id="ContactMessage" name="contact[body]" rows="7" required>{{ form.body }}</textarea>

    <button class="customer-button" type="submit">{{ 'contact.submit' | t }}</button>
  {% endform %}
</section>

{% stylesheet %}
  .contact-page__direct { margin-block: 24px 32px; }
  .contact-page__direct p { margin: 0 0 6px; }
  .contact-page__direct a { display: block; width: fit-content; color: var(--accent); font-weight: 500; }
  .contact-page__reply { margin-top: 8px !important; color: var(--ink-secondary); }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact page"
}
{% endschema %}
