{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif
%}

<section class="path-selector" aria-label="Product path selector">
  <h2>{% if is_ar %}لست متأكداً أي نظام يناسبك؟ أجب على سؤال واحد:{% else %}Not sure which system fits you? Answer 1 question:{% endif %}</h2>
  <div class="path-selector__buttons">
    <button type="button" data-path-target="amazon-fba-blueprint">{% if is_ar %}أريد البيع على أمازون{% else %}I want to sell on Amazon{% endif %}</button>
    <button type="button" data-path-target="dropshipping-mastery-system">{% if is_ar %}أريد البيع بدون مخزون{% else %}I want to sell without inventory{% endif %}</button>
    <button type="button" data-path-target="online-income-system">{% if is_ar %}أريد استخدام أدوات AI للدخل أونلاين{% else %}I want to use AI tools to earn online{% endif %}</button>
  </div>
</section>

{% stylesheet %}
  .path-selector {
    width: min(var(--page-width), calc(100vw - 2rem));
    margin: 2rem auto 0;
    padding: 1.5rem;
    color: #fff;
    background: #123A6B;
    border-radius: 8px;
    box-shadow: 6px 6px 0 rgba(16, 36, 62, 0.18);
    text-align: center;
  }

  .path-selector h2 {
    margin: 0 0 1rem;
    font-family: var(--heading);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 0.98;
    text-transform: uppercase;
  }

  .path-selector__buttons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .path-selector button {
    min-height: 52px;
    padding: 0.8rem 1rem;
    color: #123A6B;
    background: var(--color-surface);
    border: 0;
    border-radius: 5px;
    font-weight: 900;
  }

  .path-selector button:hover,
  .path-selector button:focus-visible {
    background: #E8A020;
    color: #fff;
  }

  .inside-card.is-path-highlight {
    box-shadow: 0 0 0 3px #E8A020, 10px 10px 0 rgba(232, 160, 32, 0.2);
  }

  @media (max-width: 760px) {
    .path-selector__buttons {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-path-target]');
    if (!button) return;
    var handle = button.getAttribute('data-path-target');
    var card = document.querySelector('[data-product-card="' + handle + '"]');
    if (!card) return;
    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    card.classList.add('is-path-highlight');
    window.setTimeout(function () { card.classList.remove('is-path-highlight'); }, 3000);
  });
{% endjavascript %}

{% schema %}
{
  "name": "Path selector",
  "presets": [{ "name": "Path selector" }]
}
{% endschema %}
