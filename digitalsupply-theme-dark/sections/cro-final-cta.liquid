{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif

  assign amazon_product = section.settings.amazon_product
  assign dropshipping_product = section.settings.dropshipping_product
  assign ai_product = section.settings.ai_product
  assign discount_percent = section.settings.bundle_discount_percent | default: 20
  assign bundle_variant_ids = ''
  assign bundle_url = routes.all_products_collection_url

  if amazon_product != blank
    assign amazon_variant = amazon_product.selected_or_first_available_variant
    assign amazon_price = amazon_product.price
  endif
  if dropshipping_product != blank
    assign dropshipping_variant = dropshipping_product.selected_or_first_available_variant
    assign dropshipping_price = dropshipping_product.price
  endif
  if ai_product != blank
    assign ai_variant = ai_product.selected_or_first_available_variant
    assign ai_price = ai_product.price
  endif

  assign bundle_original = amazon_price | plus: dropshipping_price | plus: ai_price
  assign bundle_savings = bundle_original | times: discount_percent | divided_by: 100
  assign bundle_final = bundle_original | minus: bundle_savings

  if amazon_variant != blank and dropshipping_variant != blank and ai_variant != blank
    assign bundle_variant_ids = amazon_variant.id | append: ',' | append: dropshipping_variant.id | append: ',' | append: ai_variant.id
    assign bundle_path = '/cart/' | append: amazon_variant.id | append: ':1,' | append: dropshipping_variant.id | append: ':1,' | append: ai_variant.id | append: ':1'
    assign encoded_bundle_path = bundle_path | url_encode
    assign bundle_url = routes.root_url | append: 'discount/' | append: section.settings.discount_code | append: '?redirect=' | append: encoded_bundle_path
  endif

  assign eyebrow = section.settings.eyebrow_en
  assign heading = section.settings.heading_en
  assign button_label = section.settings.button_en
  assign reassurance = section.settings.reassurance_en
  assign badge = section.settings.badge_en
  if is_ar
    assign eyebrow = section.settings.eyebrow_ar | default: eyebrow
    assign heading = section.settings.heading_ar | default: heading
    assign button_label = section.settings.button_ar | default: button_label
    assign reassurance = section.settings.reassurance_ar | default: reassurance
    assign badge = section.settings.badge_ar | default: badge
  endif
%}

<section class="apple-bundle section-space section-surface" id="bundle" aria-labelledby="BundleHeading">
  <div class="page-shell apple-bundle__inner" data-reveal>
    <span class="apple-bundle__badge">{{ badge }}</span>
    <p class="eyebrow">{{ eyebrow }}</p>
    <h2 class="display-type" id="BundleHeading">{{ heading }}</h2>
    <div class="apple-bundle__price">
      <s>{{ bundle_original | money }}</s>
      <strong>{{ bundle_final | money }}</strong>
      <span>{% if is_ar %}وفر {{ bundle_savings | money }}{% else %}Save {{ bundle_savings | money }}{% endif %}</span>
    </div>

    <div class="apple-bundle__covers" aria-hidden="true">
      {% for cover_index in (1..3) %}
        {% liquid
          if cover_index == 1
            assign cover_product = amazon_product
          elsif cover_index == 2
            assign cover_product = ai_product
          else
            assign cover_product = dropshipping_product
          endif
        %}
        {% if cover_product.featured_image %}
          {{ cover_product.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', width: 96, height: 120, alt: '' }}
        {% endif %}
      {% endfor %}
    </div>

    <a
      class="button-primary apple-bundle__button"
      href="{{ bundle_url }}"
      {% if bundle_variant_ids != blank %}
        data-bundle-add-trigger
        data-bundle-variant-ids="{{ bundle_variant_ids }}"
        data-bundle-cart-url="{{ routes.cart_url }}.js"
        data-bundle-add-url="{{ routes.cart_add_url }}.js"
        data-bundle-loading="{% if is_ar %}جاري تجهيز الباقة...{% else %}Preparing bundle...{% endif %}"
        data-bundle-error="{% if is_ar %}تعذر تجهيز الباقة. حاول مرة أخرى.{% else %}We could not prepare the bundle. Please try again.{% endif %}"
      {% endif %}
    >{{ button_label }}</a>
    <p class="caption apple-bundle__reassurance">{{ reassurance }}</p>
  </div>
</section>

{% stylesheet %}
  .apple-bundle__inner {
    padding: 72px 40px;
    position: relative;
    display: grid;
    justify-items: center;
    overflow: hidden;
    text-align: center;
    background:
      radial-gradient(120% 100% at 50% 0%, rgba(255, 107, 26, .16) 0%, transparent 62%),
      linear-gradient(180deg, rgba(255, 255, 255, .07) 0%, rgba(255, 255, 255, .02) 100%);
    border: 1px solid var(--line-strong);
    border-radius: var(--feature-radius);
    box-shadow: var(--shadow-card);
  }

  /* Bright seam across the top edge. */
  .apple-bundle__inner::before {
    content: "";
    height: 1px;
    position: absolute;
    inset: 0 0 auto;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .7), transparent);
  }

  .apple-bundle__badge { margin-bottom: 24px; padding: 7px 14px; color: var(--accent-ink); background: var(--accent); border-radius: var(--pill-radius); font-size: 13px; font-weight: 600; letter-spacing: .02em; }
  .apple-bundle .eyebrow { margin-bottom: 16px; }
  .apple-bundle h2 { margin-bottom: 24px; }
  .apple-bundle__price { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 20px; }
  .apple-bundle__price s { color: var(--ink-secondary); font-size: 20px; }
  .apple-bundle__price strong { color: var(--ink); font-size: 56px; font-weight: 700; line-height: 1; letter-spacing: -.03em; }
  .apple-bundle__price span { padding: 6px 12px; color: var(--ink); background: color-mix(in srgb, var(--accent) 10%, transparent); border: 1px solid var(--accent); border-radius: var(--pill-radius); font-size: 13px; font-weight: 600; }
  .apple-bundle__covers { margin-block: 36px; display: flex; justify-content: center; gap: 12px; }
  .apple-bundle__covers img { width: 96px; height: 120px; object-fit: cover; border-radius: var(--thumb-radius); }
  .apple-bundle__button { min-width: 220px; }
  .apple-bundle__reassurance { margin: 16px 0 0; color: var(--ink-secondary); }
  @media (max-width: 749px) { .apple-bundle__inner { padding: 48px 20px; } .apple-bundle__price { display: grid; } .apple-bundle__price strong { font-size: 44px; } .apple-bundle__covers img { width: 76px; height: 95px; } .apple-bundle__button { width: 100%; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Apple bundle",
  "settings": [
    { "type": "product", "id": "amazon_product", "label": "Amazon product" },
    { "type": "product", "id": "ai_product", "label": "AI product" },
    { "type": "product", "id": "dropshipping_product", "label": "Dropshipping product" },
    { "type": "range", "id": "bundle_discount_percent", "label": "Bundle saving percent", "min": 0, "max": 80, "step": 1, "default": 20 },
    { "type": "text", "id": "discount_code", "label": "Discount code", "default": "BUNDLE20" },
    { "type": "text", "id": "badge_en", "label": "Badge - English", "default": "Best Value" },
    { "type": "text", "id": "badge_ar", "label": "Badge - Arabic", "default": "الأفضل قيمة" },
    { "type": "text", "id": "eyebrow_en", "label": "Eyebrow - English", "default": "Complete bundle" },
    { "type": "text", "id": "eyebrow_ar", "label": "Eyebrow - Arabic", "default": "الباقة الكاملة" },
    { "type": "text", "id": "heading_en", "label": "Heading - English", "default": "All three systems. One price." },
    { "type": "text", "id": "heading_ar", "label": "Heading - Arabic", "default": "الأنظمة الثلاثة. بسعر واحد." },
    { "type": "text", "id": "button_en", "label": "Button - English", "default": "Get the bundle" },
    { "type": "text", "id": "button_ar", "label": "Button - Arabic", "default": "احصل على الباقة" },
    { "type": "text", "id": "reassurance_en", "label": "Reassurance - English", "default": "Discount applied automatically · 30-day money-back" },
    { "type": "text", "id": "reassurance_ar", "label": "Reassurance - Arabic", "default": "الخصم يطبق تلقائياً · ضمان استرداد 30 يوم" }
  ],
  "presets": [{ "name": "Apple bundle" }]
}
{% endschema %}
