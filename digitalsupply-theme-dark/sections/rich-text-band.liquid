{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif

  assign eyebrow = section.settings.eyebrow_en
  assign heading = section.settings.heading_en
  assign text = section.settings.text_en
  if is_ar
    assign eyebrow = section.settings.eyebrow_ar | default: eyebrow
    assign heading = section.settings.heading_ar | default: heading
    assign text = section.settings.text_ar | default: text
  endif
%}

<section class="description-band">
  <div>
    {% if eyebrow != blank %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
    <h2>{{ heading }}</h2>
  </div>
  <p>{{ text }}</p>
</section>

{% schema %}
{
  "name": "Rich text band",
  "settings": [
    { "type": "text", "id": "eyebrow_en", "label": "Eyebrow - English", "default": "Digital delivery" },
    { "type": "text", "id": "eyebrow_ar", "label": "Eyebrow - Arabic", "default": "تسليم رقمي" },
    { "type": "text", "id": "heading_en", "label": "Heading - English", "default": "Built for products customers download, learn, and use immediately." },
    { "type": "text", "id": "heading_ar", "label": "Heading - Arabic", "default": "مصمم لمنتجات يحمّلها العميل ويتعلم منها فوراً." },
    { "type": "textarea", "id": "text_en", "label": "Text - English", "default": "Use this band for product promises, digital delivery notes, refund policy highlights, or your strongest store positioning." },
    { "type": "textarea", "id": "text_ar", "label": "Text - Arabic", "default": "استخدم هذا القسم لشرح الوعود، ملاحظات التسليم الرقمي، سياسة الاسترداد، أو أقوى رسالة للمتجر." }
  ],
  "presets": [
    { "name": "Rich text band" }
  ]
}
{% endschema %}
