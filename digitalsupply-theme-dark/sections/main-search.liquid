<section class="search-wrap">
  <h1>
    {% if search.performed %}
      {{ 'general.search.results_for' | t: terms: search.terms }}
    {% else %}
      {{ 'accessibility.search' | t }}
    {% endif %}
  </h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="customer-form">
    <label class="sr-only" for="SearchInput">{{ 'accessibility.search' | t }}</label>
    <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
    <button class="customer-button" type="submit">{{ 'general.search.submit' | t }}</button>
  </form>

  {% if search.performed %}
    {% paginate search.results by 12 %}
      <div class="inside-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            {% unless item.handle == 'shipping-protection' %}
            {% render 'product-card',
              product_card_product: item,
              fallback_handle: item.handle,
              fallback_title_en: item.title,
              fallback_title_ar: item.title,
              fallback_text_en: item.description | strip_html | truncate: 140,
              fallback_text_ar: item.description | strip_html | truncate: 140,
              fallback_price: item.price | money,
              fallback_badge: 'PDF',
              fallback_cover: 'generic'
            %}
            {% endunless %}
          {% endif %}
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}
        <nav class="pagination" role="navigation">{{ paginate | default_pagination }}</nav>
      {% endif %}
    {% endpaginate %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Search"
}
{% endschema %}
