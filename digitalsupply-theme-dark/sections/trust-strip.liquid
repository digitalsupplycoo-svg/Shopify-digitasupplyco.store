{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif
%}

<section class="trust-strip trust-strip--conversion" aria-label="Store promises">
  {% for block in section.blocks %}
    {% liquid
      assign text = block.settings.text_en
      assign icon = block.settings.icon
      if is_ar
        assign text = block.settings.text_ar | default: text
      endif
    %}
    <p {{ block.shopify_attributes }}><span aria-hidden="true">{{ icon }}</span>{{ text }}</p>
  {% endfor %}
</section>

{% stylesheet %}
  .trust-strip--conversion {
    width: min(var(--content-width), calc(100% - 48px));
    margin: 32px auto;
    padding: 20px 18px;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .06) 0%, rgba(255, 255, 255, .02) 100%);
    border: 1px solid var(--line);
    border-radius: var(--card-radius);
  }

  .trust-strip--conversion p {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    color: var(--ink);
    font-family: var(--font-latin);
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    line-height: 1.3;
  }

  [dir="rtl"] .trust-strip--conversion p { font-family: var(--font-arabic); }

  .trust-strip--conversion span { font-size: 20px; line-height: 1; }

  @media (max-width: 980px) {
    .trust-strip--conversion { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 749px) {
    .trust-strip--conversion { width: min(100% - 32px, var(--content-width)); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust strip",
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        { "type": "text", "id": "text_en", "label": "Text - English", "default": "Instant access after purchase" },
        { "type": "text", "id": "text_ar", "label": "Text - Arabic", "default": "وصول فوري بعد الشراء" },
        { "type": "text", "id": "icon", "label": "Icon", "default": "⚡" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust strip",
      "blocks": [
        { "type": "promise", "settings": { "icon": "⚡", "text_en": "Instant download after checkout", "text_ar": "تحميل فوري بعد الدفع" } },
        { "type": "promise", "settings": { "icon": "↩️", "text_en": "30-day money-back guarantee", "text_ar": "ضمان استرداد 30 يوم" } },
        { "type": "promise", "settings": { "icon": "🌍", "text_en": "Built for customers worldwide", "text_ar": "مصمم للعملاء حول العالم" } },
        { "type": "promise", "settings": { "icon": "🔐", "text_en": "Secure Shopify checkout", "text_ar": "دفع آمن عبر Shopify" } },
        { "type": "promise", "settings": { "icon": "📱", "text_en": "Works from phone or laptop", "text_ar": "يعمل من الجوال أو اللابتوب" } },
        { "type": "promise", "settings": { "icon": "🇦🇪🇸🇦🇶🇦", "text_en": "Arabic + English", "text_ar": "عربي + إنجليزي" } }
      ]
    }
  ]
}
{% endschema %}
