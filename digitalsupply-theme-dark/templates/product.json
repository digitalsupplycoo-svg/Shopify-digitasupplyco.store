            "title_ar": "\u062f\u0631\u0648\u0628\u0634\u064a\u0628\u064a\u0646\u063a \u2014 \u0627\u0628\u062f\u0623 \u0645\u062a\u062c\u0631 \u0628\u062f\u0648\u0646 \u0645\u062e\u0632\u0648\u0646",
