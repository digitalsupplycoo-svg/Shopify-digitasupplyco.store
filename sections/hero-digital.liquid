{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif

  assign hero_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
  assign cta_url = section.settings.cta_link | default: '#shop-products'
  if cta_url == blank
    assign cta_url = routes.all_products_collection_url
  endif

  assign image_alt = section.settings.image_alt_en
  assign cta_label = section.settings.cta_label_en
  if is_ar
    assign image_alt = section.settings.image_alt_ar | default: image_alt
    assign cta_label = section.settings.cta_label_ar | default: cta_label
  endif
%}

<section
  class="digital-products-hero"
  aria-label="{{ image_alt | escape }}"
  style="
    --hero-cta-left-desktop: {{ section.settings.cta_left_desktop }}%;
    --hero-cta-top-desktop: {{ section.settings.cta_top_desktop }}%;
    --hero-cta-width-desktop: {{ section.settings.cta_width_desktop }}%;
    --hero-cta-height-desktop: {{ section.settings.cta_height_desktop }}%;
    --hero-cta-left-tablet: {{ section.settings.cta_left_tablet }}%;
    --hero-cta-top-tablet: {{ section.settings.cta_top_tablet }}%;
    --hero-cta-width-tablet: {{ section.settings.cta_width_tablet }}%;
    --hero-cta-height-tablet: {{ section.settings.cta_height_tablet }}%;
    --hero-cta-left-mobile: {{ section.settings.cta_left_mobile }}%;
    --hero-cta-top-mobile: {{ section.settings.cta_top_mobile }}%;
    --hero-cta-width-mobile: {{ section.settings.cta_width_mobile }}%;
    --hero-cta-height-mobile: {{ section.settings.cta_height_mobile }}%;
  "
>
  <div class="digital-products-hero__frame">
    <picture>
      {% if mobile_image != blank %}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ mobile_image | image_url: width: 320 }} 320w,
            {{ mobile_image | image_url: width: 375 }} 375w,
            {{ mobile_image | image_url: width: 430 }} 430w,
            {{ mobile_image | image_url: width: 750 }} 750w,
            {{ mobile_image | image_url: width: 900 }} 900w
          "
          sizes="100vw"
        >
      {% endif %}

      {% if hero_image != blank %}
        <img
          class="digital-products-hero__image"
          src="{{ hero_image | image_url: width: 1672 }}"
          srcset="
            {{ hero_image | image_url: width: 320 }} 320w,
            {{ hero_image | image_url: width: 375 }} 375w,
            {{ hero_image | image_url: width: 430 }} 430w,
            {{ hero_image | image_url: width: 768 }} 768w,
            {{ hero_image | image_url: width: 1024 }} 1024w,
            {{ hero_image | image_url: width: 1366 }} 1366w,
            {{ hero_image | image_url: width: 1672 }} 1672w
          "
          sizes="(max-width: 749px) 100vw, min(100vw, 1672px)"
          width="{{ hero_image.width }}"
          height="{{ hero_image.height }}"
          loading="eager"
          fetchpriority="high"
          alt="{{ image_alt | escape }}"
        >
      {% elsif mobile_image != blank %}
        <img
          class="digital-products-hero__image"
          src="{{ mobile_image | image_url: width: 900 }}"
          srcset="
            {{ mobile_image | image_url: width: 320 }} 320w,
            {{ mobile_image | image_url: width: 375 }} 375w,
            {{ mobile_image | image_url: width: 430 }} 430w,
            {{ mobile_image | image_url: width: 750 }} 750w,
            {{ mobile_image | image_url: width: 900 }} 900w
          "
          sizes="100vw"
          width="{{ mobile_image.width }}"
          height="{{ mobile_image.height }}"
          loading="eager"
          fetchpriority="high"
          alt="{{ image_alt | escape }}"
        >
      {% else %}
        <img
          class="digital-products-hero__image"
          src="{{ 'digital-products-home-hero-promo.png' | asset_url }}"
          width="1672"
          height="941"
          loading="eager"
          fetchpriority="high"
          alt="{{ image_alt | escape }}"
        >
      {% endif %}
    </picture>

    <a class="digital-products-hero__cta" href="{{ cta_url }}" aria-label="{{ cta_label | escape }}"></a>
  </div>
</section>

{% stylesheet %}
  html {
    scroll-behavior: smooth;
  }

  .digital-products-hero {
    width: min(100%, 1672px);
    margin-inline: auto;
    padding: 0.5rem 0 1rem;
    background: #10243E;
  }

  .digital-products-hero__frame {
    position: relative;
    width: 100%;
    overflow: visible;
    background: #10243E;
    line-height: 0;
  }

  .digital-products-hero__image {
    width: 100%;
    height: auto;
    max-width: 100%;
    display: block;
    object-fit: contain;
  }

  .digital-products-hero__cta {
    position: absolute;
    left: var(--hero-cta-left-desktop);
    top: var(--hero-cta-top-desktop);
    width: var(--hero-cta-width-desktop);
    height: var(--hero-cta-height-desktop);
    min-height: 48px;
    display: block;
    border-radius: 10px;
    z-index: 3;
  }

  .digital-products-hero__cta:focus-visible {
    outline: 3px solid #DCE4EC;
    outline-offset: 4px;
    background: rgba(159, 247, 239, 0.08);
  }

  @media (max-width: 1024px) {
    .digital-products-hero {
      padding-top: 0.35rem;
    }

    .digital-products-hero__cta {
      left: var(--hero-cta-left-tablet);
      top: var(--hero-cta-top-tablet);
      width: var(--hero-cta-width-tablet);
      height: var(--hero-cta-height-tablet);
    }
  }

  @media (max-width: 749px) {
    .digital-products-hero {
      width: 100%;
      padding: 0.25rem 0 0.65rem;
      overflow: visible;
    }

    .digital-products-hero__frame {
      height: auto;
      min-height: auto;
      overflow: visible;
    }

    .digital-products-hero__image {
      width: 100%;
      height: auto;
      max-width: 100%;
      object-fit: contain;
      display: block;
    }

    .digital-products-hero__cta {
      left: var(--hero-cta-left-mobile);
      top: var(--hero-cta-top-mobile);
      width: var(--hero-cta-width-mobile);
      height: var(--hero-cta-height-mobile);
      min-height: 48px;
      border-radius: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Digital products hero",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop hero image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile hero image" },
    { "type": "text", "id": "image_alt_en", "label": "Image alt text - English", "default": "DigitalSupply Co digital products: Amazon FBA Blueprint, AI Income System, and Dropshipping Mastery System" },
    { "type": "text", "id": "image_alt_ar", "label": "Image alt text - Arabic", "default": "منتجات DigitalSupply Co الرقمية: Amazon FBA Blueprint و AI Income System و Dropshipping Mastery System" },
    { "type": "url", "id": "cta_link", "label": "CTA destination" },
    { "type": "text", "id": "cta_label_en", "label": "CTA accessibility label - English", "default": "Choose your digital product" },
    { "type": "text", "id": "cta_label_ar", "label": "CTA accessibility label - Arabic", "default": "اختر منتجك الرقمي" },
    { "type": "range", "id": "cta_left_desktop", "label": "Desktop CTA left", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 36 },
    { "type": "range", "id": "cta_top_desktop", "label": "Desktop CTA top", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 79 },
    { "type": "range", "id": "cta_width_desktop", "label": "Desktop CTA width", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 28 },
    { "type": "range", "id": "cta_height_desktop", "label": "Desktop CTA height", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 8 },
    { "type": "range", "id": "cta_left_tablet", "label": "Tablet CTA left", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 34 },
    { "type": "range", "id": "cta_top_tablet", "label": "Tablet CTA top", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 78 },
    { "type": "range", "id": "cta_width_tablet", "label": "Tablet CTA width", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 32 },
    { "type": "range", "id": "cta_height_tablet", "label": "Tablet CTA height", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 10 },
    { "type": "range", "id": "cta_left_mobile", "label": "Mobile CTA left", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 21 },
    { "type": "range", "id": "cta_top_mobile", "label": "Mobile CTA top", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 74 },
    { "type": "range", "id": "cta_width_mobile", "label": "Mobile CTA width", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 58 },
    { "type": "range", "id": "cta_height_mobile", "label": "Mobile CTA height", "min": 1, "max": 100, "step": 1, "unit": "%", "default": 22 }
  ],
  "presets": [
    {
      "name": "Digital products hero"
    }
  ]
}
{% endschema %}
