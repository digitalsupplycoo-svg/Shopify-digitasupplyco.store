{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif
  assign newsletter_text = section.settings.newsletter_text_en
  assign newsletter_button = section.settings.newsletter_button_en
  if is_ar
    assign newsletter_text = section.settings.newsletter_text_ar | default: newsletter_text
    assign newsletter_button = section.settings.newsletter_button_ar | default: newsletter_button
  endif
%}

<footer class="apple-footer">
  <div class="page-shell apple-footer__newsletter">
    <p>{{ newsletter_text }}</p>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="sr-only" for="FooterNewsletterEmail">{{ 'general.newsletter.email' | t }}</label>
      <input id="FooterNewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.email' | t }}" required>
      <button class="button-primary" type="submit">{{ newsletter_button }}</button>
      {% if form.posted_successfully? %}<p>{{ 'general.newsletter.success' | t }}</p>{% endif %}
      {{ form.errors | default_errors }}
    {% endform %}
  </div>

  <div class="page-shell apple-footer__links">
    <nav aria-label="{% if is_ar %}المنتجات{% else %}Products{% endif %}">
      <h2>{% if is_ar %}المنتجات{% else %}Products{% endif %}</h2>
      <a href="{{ routes.root_url }}products/amazon-fba-blueprint">Amazon FBA Blueprint™</a>
      <a href="{{ routes.root_url }}products/online-income-system">AI Income System™</a>
      <a href="{{ routes.root_url }}products/dropshipping-mastery-system">Dropshipping Mastery System™</a>
    </nav>
    <nav aria-label="{% if is_ar %}الشركة{% else %}Company{% endif %}">
      <h2>{% if is_ar %}الشركة{% else %}Company{% endif %}</h2>
      <a href="{{ routes.root_url }}#faq">{{ 'cro.faq' | t }}</a>
      <a href="{{ routes.root_url }}pages/contact">{% if is_ar %}تواصل معنا{% else %}Contact{% endif %}</a>
      {% if shop.refund_policy != blank %}
        <a href="{{ shop.refund_policy.url }}">{% if is_ar %}سياسة الاسترداد{% else %}Refund Policy{% endif %}</a>
      {% endif %}
      {% if shop.terms_of_service != blank %}
        <a href="{{ shop.terms_of_service.url }}">{% if is_ar %}شروط الخدمة{% else %}Terms of Service{% endif %}</a>
      {% endif %}
      {% if shop.privacy_policy != blank %}
        <a href="{{ shop.privacy_policy.url }}">{% if is_ar %}سياسة الخصوصية{% else %}Privacy Policy{% endif %}</a>
      {% endif %}
      {% if settings.support_email != blank %}
        <a class="apple-footer__email" href="mailto:{{ settings.support_email | escape }}">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <span>{{ settings.support_email }}</span>
        </a>
      {% endif %}
    </nav>
  </div>

  <div class="page-shell apple-footer__bottom">
    <a class="apple-footer__wordmark" href="{{ routes.root_url }}">DigitalSupply <span>Co</span></a>
    <div class="apple-footer__meta">
      <span>Visa</span><span>Mastercard</span><span>Apple Pay</span>
      <small>© {{ 'now' | date: '%Y' }} DigitalSupply Co</small>
    </div>
  </div>
</footer>

{% stylesheet %}
  .apple-footer { padding-block: 64px 32px; color: var(--footer-text); background: var(--footer-bg); border-top: 1px solid var(--line); }
  .apple-footer__newsletter { padding-bottom: 48px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(420px, 560px); gap: 48px; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, .2); }
  .apple-footer__newsletter > p { max-width: 460px; margin: 0; color: var(--footer-text); font-size: 17px; }
  .apple-footer__newsletter form { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
  .apple-footer__newsletter input { min-height: 48px; padding: 12px 14px; color: var(--footer-text); background: var(--footer-bg); border: 1px solid rgba(255, 255, 255, .2); border-radius: 10px; }
  .apple-footer__newsletter input::placeholder { color: var(--footer-secondary); }
  .apple-footer__links { padding-block: 48px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; }
  .apple-footer__links nav { display: grid; align-content: start; gap: 10px; }
  .apple-footer__links h2 { margin: 0 0 6px; color: var(--footer-secondary); font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .apple-footer__links a { width: fit-content; color: var(--footer-secondary); font-size: 15px; }
  .apple-footer__links a:hover { color: var(--footer-text); }
  .apple-footer__email { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
  .apple-footer__email:hover { text-decoration: underline; text-underline-offset: 3px; }
  .apple-footer__bottom { padding-top: 24px; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-top: 1px solid rgba(255, 255, 255, .2); }
  .apple-footer__wordmark { color: var(--footer-text); font-size: 19px; font-weight: 600; }
  .apple-footer__wordmark span { color: var(--footer-text); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 4px; }
  .apple-footer__meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 10px; color: var(--footer-secondary); font-size: 13px; }
  .apple-footer__meta span { padding: 5px 11px; background: rgba(255, 255, 255, .06); border: 1px solid var(--line); border-radius: var(--pill-radius); font-size: 12px; font-weight: 500; }
  .apple-footer__meta small { font-size: 13px; }
  @media (max-width: 749px) { .apple-footer__newsletter { grid-template-columns: 1fr; gap: 24px; } .apple-footer__newsletter form { grid-template-columns: 1fr; } .apple-footer__links { grid-template-columns: 1fr; gap: 32px; } .apple-footer__bottom { align-items: flex-start; flex-direction: column; } .apple-footer__meta { justify-content: flex-start; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Apple footer",
  "settings": [
    { "type": "textarea", "id": "newsletter_text_en", "label": "Newsletter text - English", "default": "Practical notes for choosing and applying the right digital system. No inflated promises." },
    { "type": "textarea", "id": "newsletter_text_ar", "label": "Newsletter text - Arabic", "default": "ملاحظات عملية لاختيار النظام الرقمي المناسب وتطبيقه، بدون وعود مبالغ فيها." },
    { "type": "text", "id": "newsletter_button_en", "label": "Button - English", "default": "Subscribe" },
    { "type": "text", "id": "newsletter_button_ar", "label": "Button - Arabic", "default": "اشترك" }
  ]
}
{% endschema %}
