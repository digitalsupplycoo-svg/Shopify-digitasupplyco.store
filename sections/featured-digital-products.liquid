{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif

  assign heading = section.settings.heading_en
  assign text = section.settings.text_en
  if is_ar
    assign heading = section.settings.heading_ar | default: heading
    assign text = section.settings.text_ar | default: text
  endif

%}

<section class="inside-section" id="products">
  <span class="anchor-target" id="shop-products" aria-hidden="true"></span>
  <span class="anchor-target" id="downloads" aria-hidden="true"></span>
  <div class="section-heading">
    <h2>{{ heading }}</h2>
    {% if text != blank %}<p>{{ text }}</p>{% endif %}
  </div>

  <div class="inside-grid">
    {% for block in section.blocks %}
      {% render 'product-card',
        product_card_product: block.settings.product,
        fallback_handle: block.settings.fallback_handle,
        fallback_title_en: block.settings.title_en,
        fallback_title_ar: block.settings.title_ar,
        fallback_text_en: block.settings.text_en,
        fallback_text_ar: block.settings.text_ar,
        fallback_price: block.settings.price,
        fallback_badge: block.settings.badge,
        fallback_cover: block.settings.cover,
        card_image_en: block.settings.image_en,
        card_image_ar: block.settings.image_ar
      %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured digital products",
  "settings": [
    { "type": "text", "id": "heading_en", "label": "Heading - English", "default": "Choose your digital system" },
    { "type": "text", "id": "heading_ar", "label": "Heading - Arabic", "default": "اختر نظامك الرقمي" },
    { "type": "textarea", "id": "text_en", "label": "Text - English", "default": "Each product card can connect to a real Shopify product, image, price, and product page." },
    { "type": "textarea", "id": "text_ar", "label": "Text - Arabic", "default": "يمكن ربط كل بطاقة بمنتج شوبيفاي حقيقي مع الصورة والسعر وصفحة المنتج." }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "product", "id": "product", "label": "Shopify product" },
        { "type": "image_picker", "id": "image_en", "label": "Card image override - English" },
        { "type": "image_picker", "id": "image_ar", "label": "Card image override - Arabic" },
        { "type": "text", "id": "fallback_handle", "label": "Fallback product handle", "default": "dropshipping-mastery-system" },
        { "type": "select", "id": "cover", "label": "Fallback cover", "default": "dropshipping", "options": [
          { "value": "dropshipping", "label": "Dropshipping" },
          { "value": "amazon", "label": "Amazon FBA" },
          { "value": "online", "label": "Online Income" },
          { "value": "generic", "label": "Generic" }
        ] },
        { "type": "text", "id": "badge", "label": "Fallback badge", "default": "PDF" },
        { "type": "text", "id": "title_en", "label": "Title - English" },
        { "type": "text", "id": "title_ar", "label": "Title - Arabic" },
        { "type": "textarea", "id": "text_en", "label": "Text - English" },
        { "type": "textarea", "id": "text_ar", "label": "Text - Arabic" },
        { "type": "text", "id": "price", "label": "Fallback price" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured digital products",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "fallback_handle": "dropshipping-mastery-system",
            "cover": "dropshipping",
            "badge": "DS",
            "title_en": "Dropshipping Mastery System™",
            "title_ar": "نظام احتراف الدروبشيبينغ™",
            "text_en": "A practical operating system for product research, supplier setup, store launch, and testing offers.",
            "text_ar": "نظام عملي للبحث عن المنتجات، تجهيز الموردين، إطلاق المتجر، واختبار العروض.",
            "price": ""
          }
        },
        {
          "type": "product_card",
          "settings": {
            "fallback_handle": "amazon-fba-blueprint",
            "cover": "amazon",
            "badge": "FBA",
            "title_en": "Amazon FBA Blueprint™",
            "title_ar": "مخطط أمازون FBA™",
            "text_en": "A structured blueprint for product validation, sourcing, listing, launch planning, and PPC basics.",
            "text_ar": "مخطط منظم للتحقق من المنتجات، التوريد، إعداد الصفحة، خطة الإطلاق، وأساسيات الإعلانات.",
            "price": ""
          }
        },
        {
          "type": "product_card",
          "settings": {
            "fallback_handle": "online-income-system",
            "cover": "online",
            "badge": "AI",
            "title_en": "Online Income System™",
            "title_ar": "نظام الدخل الأونلاين™",
            "text_en": "A beginner-friendly system for choosing an offer, setting up simple assets, and building repeatable online income workflows.",
            "text_ar": "نظام مناسب للمبتدئين لاختيار العرض، تجهيز الأصول الأساسية، وبناء خطوات قابلة للتكرار للدخل الأونلاين.",
            "price": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
