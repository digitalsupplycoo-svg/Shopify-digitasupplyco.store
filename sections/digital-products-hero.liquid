    { "type": "text", "id": "eyebrow_ar", "label": "Eyebrow - Arabic", "default": "أنظمة رقمية · وصول فوري" },
    { "type": "text", "id": "heading_en", "label": "Heading line 1 - English", "default": "Your First" },
    { "type": "text", "id": "heading_ar", "label": "Heading line 1 - Arabic", "default": "ابدأ مسارك" },
