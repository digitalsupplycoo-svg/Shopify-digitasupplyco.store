{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif

  assign eyebrow = section.settings.eyebrow_en
  assign heading = section.settings.heading_en
  assign heading_secondary = section.settings.heading_secondary_en
  assign subheading = section.settings.subheading_en
  assign primary_label = section.settings.primary_label_en
  assign secondary_label = section.settings.secondary_label_en
  assign trust_pill = section.settings.trust_pill_en
  assign trust_one = section.settings.trust_one_en
  assign trust_two = section.settings.trust_two_en
  assign trust_three = section.settings.trust_three_en

  if is_ar
    assign eyebrow = section.settings.eyebrow_ar | default: eyebrow
    assign heading = section.settings.heading_ar | default: heading
    assign heading_secondary = section.settings.heading_secondary_ar | default: heading_secondary
    assign subheading = section.settings.subheading_ar | default: subheading
    assign primary_label = section.settings.primary_label_ar | default: primary_label
    assign secondary_label = section.settings.secondary_label_ar | default: secondary_label
    assign trust_pill = section.settings.trust_pill_ar | default: trust_pill
    assign trust_one = section.settings.trust_one_ar | default: trust_one
    assign trust_two = section.settings.trust_two_ar | default: trust_two
    assign trust_three = section.settings.trust_three_ar | default: trust_three
  endif
%}

<section class="hero-cinema" aria-label="{{ section.settings.accessibility_label | escape }}">
  <div class="hero-cinema__bg" aria-hidden="true">
    {% if section.settings.video_url != blank %}
      <video
        class="hero-cinema__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        tabindex="-1"
        data-hero-video
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {% endif %}
    <div class="hero-cinema__scrim"></div>
  </div>

  <div class="page-shell hero-cinema__inner">
    <p class="eyebrow hero-cinema__eyebrow" data-reveal>{{ eyebrow }}</p>

    {%- comment -%}
      Trust cluster: overlapping rings of topic icons, then a claim pill. The
      icons describe what each system covers — they are not endorsement marks,
      and the pill must only carry claims the store can substantiate.
    {%- endcomment -%}
    {% if section.blocks.size > 0 %}
      <div class="hero-trust" data-reveal>
        <div class="hero-trust__avatars">
          {%- comment -%}
            Topic glyphs, not cover art — detailed covers turn to noise at 34px.
          {%- endcomment -%}
          {% for block in section.blocks limit: 3 %}
            <span class="hero-trust__avatar" {{ block.shopify_attributes }}>
              <span class="hero-trust__disc">
                <i class="{{ block.settings.icon | default: 'fa-solid fa-bolt' }}" aria-hidden="true"></i>
              </span>
            </span>
          {% endfor %}
        </div>
        {% if trust_pill != blank %}
          <span class="hero-trust__pill">{{ trust_pill }}</span>
        {% endif %}
      </div>
    {% endif %}

    <h1 class="hero-cinema__headline display-type">
      <span class="hero-cinema__line" style="--line-delay: .12s">{{ heading }}</span>
      {% if heading_secondary != blank %}
        <span class="hero-cinema__line" style="--line-delay: .3s">{{ heading_secondary }}</span>
      {% endif %}
    </h1>

    <p class="hero-cinema__subheading" data-reveal>{{ subheading }}</p>

    <div class="hero-cinema__actions" data-reveal>
      <a class="button-primary" href="{{ section.settings.primary_link | default: '#pricing' }}">{{ primary_label }}</a>
      <a class="button-ghost" href="{{ section.settings.secondary_link | default: '#bundle' }}">{{ secondary_label }}</a>
    </div>

    <div class="hero-cinema__assurance" data-reveal>
      <span><i class="fa-solid fa-bolt" aria-hidden="true"></i>{{ trust_one }}</span>
      <span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>{{ trust_two }}</span>
      <span><i class="fa-solid fa-language" aria-hidden="true"></i>{{ trust_three }}</span>
    </div>
  </div>

  {%- comment -%} Stats rail pinned to the bottom of the first viewport. {%- endcomment -%}
  <div class="page-shell hero-stats" data-hero-stats>
    {% for i in (1..4) %}
      {% liquid
        case i
          when 1
            assign glyph = section.settings.stat_1_glyph
            assign stat_value = section.settings.stat_1_value
            assign stat_suffix = section.settings.stat_1_suffix
            assign stat_suffix_ar = section.settings.stat_1_suffix_ar
            assign stat_decimals = section.settings.stat_1_decimals
            assign stat_label = section.settings.stat_1_label_en
            assign stat_label_ar = section.settings.stat_1_label_ar
          when 2
            assign glyph = section.settings.stat_2_glyph
            assign stat_value = section.settings.stat_2_value
            assign stat_suffix = section.settings.stat_2_suffix
            assign stat_suffix_ar = section.settings.stat_2_suffix_ar
            assign stat_decimals = section.settings.stat_2_decimals
            assign stat_label = section.settings.stat_2_label_en
            assign stat_label_ar = section.settings.stat_2_label_ar
          when 3
            assign glyph = section.settings.stat_3_glyph
            assign stat_value = section.settings.stat_3_value
            assign stat_suffix = section.settings.stat_3_suffix
            assign stat_suffix_ar = section.settings.stat_3_suffix_ar
            assign stat_decimals = section.settings.stat_3_decimals
            assign stat_label = section.settings.stat_3_label_en
            assign stat_label_ar = section.settings.stat_3_label_ar
          else
            assign glyph = section.settings.stat_4_glyph
            assign stat_value = section.settings.stat_4_value
            assign stat_suffix = section.settings.stat_4_suffix
            assign stat_suffix_ar = section.settings.stat_4_suffix_ar
            assign stat_decimals = section.settings.stat_4_decimals
            assign stat_label = section.settings.stat_4_label_en
            assign stat_label_ar = section.settings.stat_4_label_ar
        endcase
        if is_ar
          assign stat_label = stat_label_ar | default: stat_label
          assign stat_suffix = stat_suffix_ar | default: stat_suffix
        endif
        assign delay = i | minus: 1 | times: 8 | plus: 50 | divided_by: 100.0
      %}
      {% if stat_label != blank %}
        <div class="hero-stat" style="--d: {{ delay }}s" data-reveal>
          <span class="hero-stat__glyph display-type" aria-hidden="true">{{ glyph }}</span>
          <span
            class="hero-stat__value"
            data-count-to="{{ stat_value }}"
            data-count-decimals="{{ stat_decimals }}"
            data-count-suffix="{{ stat_suffix }}"
          >{{ stat_value }}{{ stat_suffix }}</span>
          <span class="hero-stat__label">{{ stat_label }}</span>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .hero-cinema {
    /* The header sits in flow above this section, so the first viewport is only
       complete if the hero claims exactly the remainder. */
    min-height: calc(100vh - var(--header-h, 78px));
    min-height: calc(100dvh - var(--header-h, 78px));
    padding-block: clamp(20px, 3.5vh, 40px) clamp(24px, 3.5vh, 40px);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(28px, 5vh, 56px);
    background: var(--bg);
    isolation: isolate;
  }

  /* The bg is the only clipping context — the section itself must never crop copy. */
  .hero-cinema__bg { position: absolute; inset: 0; z-index: 0; overflow: hidden; background: var(--bg); }
  .hero-cinema__video { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }

  /* Legibility floor. The video is arbitrary footage, so white type needs a
     guaranteed dark substrate rather than luck. */
  .hero-cinema__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 80% at 50% 45%, rgba(0, 0, 0, .35) 0%, rgba(0, 0, 0, .72) 60%, rgba(0, 0, 0, .9) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, .75) 0%, rgba(0, 0, 0, .35) 30%, rgba(0, 0, 0, .55) 70%, #000 100%);
  }

  .hero-cinema__inner,
  .hero-stats { position: relative; z-index: 1; }

  .hero-cinema__inner {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hero-cinema__eyebrow { margin-bottom: clamp(14px, 2vh, 20px); color: var(--ink); }

  /* Trust cluster */
  .hero-trust {
    --trust-size: clamp(36px, 4.5vw, 42px);
    margin-bottom: clamp(16px, 2.5vh, 26px);
    display: inline-flex;
    align-items: center;
  }

  .hero-trust__avatars { display: inline-flex; align-items: center; }

  .hero-trust__avatar {
    width: var(--trust-size);
    height: var(--trust-size);
    padding: 5px;
    display: grid;
    place-items: center;
    background: var(--trust-bg);
    border: 1px solid var(--trust-border);
    border-radius: 50%;
    transition: transform .35s var(--ease-out);
  }

  .hero-trust__avatar:nth-child(1) { z-index: 1; }
  .hero-trust__avatar:nth-child(2) { z-index: 2; margin-inline-start: calc(var(--trust-size) * -.42); }
  .hero-trust__avatar:nth-child(3) { z-index: 4; margin-inline-start: calc(var(--trust-size) * -.42); }

  .hero-trust:hover .hero-trust__avatar:nth-child(1) { transform: translateY(-2px); }
  .hero-trust:hover .hero-trust__avatar:nth-child(2) { transform: translateY(-4px); }
  .hero-trust:hover .hero-trust__avatar:nth-child(3) { transform: translateY(-2px); }

  .hero-trust__disc {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #111;
    background: #fff;
    border-radius: 50%;
    font-size: calc(var(--trust-size) * .34);
  }

  .hero-trust__disc img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

  .hero-trust__pill {
    min-height: var(--trust-size);
    padding-inline: calc(var(--trust-size) * .58) 16px;
    margin-inline-start: calc(var(--trust-size) * -.42);
    display: inline-flex;
    align-items: center;
    color: var(--trust-text);
    background: var(--trust-bg);
    border: 1px solid var(--trust-border);
    border-radius: var(--pill-radius);
    font-size: clamp(12px, 1.4vw, 13.5px);
    font-weight: 500;
  }

  /* Headline */
  /* The dot-matrix face is near-monospace and runs wide, so it is sized to keep
     each authored line on a single visual line rather than to the spec's 80px. */
  .hero-cinema__headline {
    max-width: min(100%, 1040px);
    margin: 0;
    font-size: clamp(30px, 4.6vw, 62px);
    line-height: 1.14;
    text-wrap: initial;
    color: var(--ink);
  }

  .hero-cinema__line { display: block; }

  .reveal-ready .hero-cinema__line {
    opacity: 0;
    transform: translateY(14px);
    animation: heroLineFade .85s var(--ease-out) var(--line-delay, 0s) forwards;
  }

  @keyframes heroLineFade {
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-cinema__subheading {
    max-width: min(560px, 92%);
    margin: clamp(16px, 2.4vh, 24px) auto 0;
    color: #D0D0D0;
    opacity: .85;
    font-size: clamp(15.5px, 1.55vw, 18.5px);
    line-height: 1.55;
  }

  .hero-cinema__actions {
    margin-top: clamp(22px, 3.4vh, 34px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .hero-cinema__assurance {
    margin-top: clamp(20px, 3vh, 30px);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 24px;
    color: #C4C2C3;
    font-size: 14px;
  }

  .hero-cinema__assurance span { display: inline-flex; align-items: center; gap: 8px; }
  .hero-cinema__assurance i { color: var(--accent); font-size: 13px; }

  /* Stats rail */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    max-width: 920px;
    text-align: center;
  }

  .hero-stat { display: grid; justify-items: center; gap: 2px; transition-delay: var(--d, 0s); }
  .hero-stat__glyph { color: var(--ink); font-size: clamp(22px, 3vw, 33px); line-height: 1; }
  /* Isolated LTR run: without this, a value like "30-day" bidi-reorders to
     "day-30" inside the Arabic (RTL) layout. Arabic suffixes still shape
     correctly, since Arabic characters are strongly RTL on their own. */
  .hero-stat__value {
    direction: ltr;
    unicode-bidi: isolate;
    color: var(--ink);
    font-family: var(--font-latin);
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: 600;
    letter-spacing: -.025em;
    font-variant-numeric: tabular-nums;
  }

  [dir="rtl"] .hero-stat__value { font-family: var(--font-arabic); }
  .hero-stat__label { color: var(--muted, var(--ink-secondary)); font-size: clamp(11px, 1.2vw, 12.5px); line-height: 1.3; }

  @media (max-width: 860px) {
    .hero-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 16px; }
  }

  @media (max-width: 749px) {
    .hero-cinema { min-height: auto; padding-block: 30px 44px; gap: 38px; }
    .hero-cinema__headline { font-size: clamp(32px, 9vw, 46px); line-height: 1.08; }
    .hero-cinema__actions { width: 100%; display: grid; gap: 12px; }
    .hero-cinema__actions > * { width: 100%; }
    .hero-cinema__assurance { gap: 10px 16px; font-size: 13px; }
  }

  @media (max-width: 420px) {
    .hero-trust { --trust-size: 34px; }
    .hero-trust__pill { font-size: 12px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-ready .hero-cinema__line { opacity: 1; transform: none; animation: none; }
  }
{% endstylesheet %}

{% schema %}
