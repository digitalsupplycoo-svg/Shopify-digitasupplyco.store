<article class="page-wrap">
  {% render 'breadcrumbs' %}
  <h1>{{ article.title }}</h1>
  {% if article.image %}
    <div class="feature-image">
      {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', alt: article.title }}
    </div>
  {% endif %}
  <div class="rte">{{ article.content }}</div>
</article>

{% schema %}
{
  "name": "Article"
}
{% endschema %}
