<section class="collection-wrap">
  {% render 'breadcrumbs' %}
  <h1>{{ blog.title }}</h1>
  {% paginate blog.articles by 12 %}
    <div class="inside-grid">
      {% for article in blog.articles %}
        <article class="inside-card">
          <a class="inside-card__media" href="{{ article.url }}">
            {% if article.image %}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}
            {% else %}
              <span class="inside-card__fallback">POST</span>
            {% endif %}
          </a>
          <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <p>{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
        </article>
      {% endfor %}
    </div>
    {% if paginate.pages > 1 %}
      <nav class="pagination" role="navigation">{{ paginate | default_pagination }}</nav>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Blog"
}
{% endschema %}
