<section class="collection-wrap">
  {% render 'breadcrumbs' %}
  <h1>{{ collection.title | default: page_title }}</h1>
  {% if collection.description != blank %}
    <div class="rte">{{ collection.description }}</div>
  {% endif %}

  {% paginate collection.products by 12 %}
    <div class="inside-grid">
      {% for product in collection.products %}
        {% unless product.handle == 'shipping-protection' %}
        {% render 'product-card',
          product_card_product: product,
          fallback_handle: product.handle,
          fallback_title_en: product.title,
          fallback_title_ar: product.title,
          fallback_text_en: product.description | strip_html | truncate: 140,
          fallback_text_ar: product.description | strip_html | truncate: 140,
          fallback_price: product.price | money,
          fallback_badge: 'PDF',
          fallback_cover: 'generic'
        %}
        {% endunless %}
      {% else %}
        <p class="empty-state">{{ 'cart.general.empty' | t }}</p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <nav class="pagination" role="navigation">
        {{ paginate | default_pagination }}
      </nav>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Collection"
}
{% endschema %}
