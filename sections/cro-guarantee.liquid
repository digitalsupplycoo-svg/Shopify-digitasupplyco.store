{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif
%}

<section class="cro-guarantee" aria-label="{% if is_ar %}ضمان الاسترداد{% else %}Money-back guarantee{% endif %}">
  <div class="cro-guarantee__seal" aria-hidden="true">30</div>
  <div>
    <p class="eyebrow">{% if is_ar %}ضمان يقلل التردد{% else %}Regret-free first step{% endif %}</p>
    <h2>{% if is_ar %}جرّب أي نظام لمدة 30 يوماً{% else %}Try any system for 30 days{% endif %}</h2>
    <p>
      {% if is_ar %}
        إذا لم يكن المنتج مناسباً لك، راسلنا خلال 30 يوماً لطلب استرداد الأموال وفقاً لسياسة المتجر.
      {% else %}
        If it is not the right fit, email us within 30 days to request a refund according to the store policy.
      {% endif %}
    </p>
    {% if shop.refund_policy != blank %}
      <a href="{{ shop.refund_policy.url }}">{% if is_ar %}اقرأ سياسة الاسترداد{% else %}Read the Refund Policy{% endif %}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .cro-guarantee {
    width: min(var(--page-width), calc(100vw - 2rem));
    margin: 3rem auto;
    padding: clamp(1.2rem, 4vw, 2rem);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.2rem;
    align-items: center;
    color: #FFFFFF;
    background: #E9F4EE;
    border-radius: 8px;
    box-shadow: 0 18px 60px rgba(16, 36, 62, 0.22);
  }

  .cro-guarantee__seal {
    width: clamp(84px, 14vw, 136px);
    height: clamp(84px, 14vw, 136px);
    display: grid;
    place-items: center;
    color: #FFFFFF;
    background: #1E6B4A;
    border: 4px solid rgba(255, 255, 255, 0.42);
    border-radius: 999px;
    font-family: var(--heading);
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1;
  }

  .cro-guarantee h2 {
    margin: 0;
    font-family: var(--heading);
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.92;
    text-transform: uppercase;
  }

  .cro-guarantee p:not(.eyebrow) {
    max-width: 800px;
    margin: 0.7rem 0 0;
    color: rgba(255, 253, 248, 0.82);
    font-size: clamp(1.04rem, 2vw, 1.25rem);
    line-height: 1.55;
  }

  [dir="rtl"] .cro-guarantee h2,
  [dir="rtl"] .cro-guarantee__seal {
    font-family: "Cairo", Tahoma, Arial, sans-serif;
    letter-spacing: 0;
    line-height: 1.15;
    text-transform: none;
  }

  @media (max-width: 640px) {
    .cro-guarantee {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .cro-guarantee__seal {
      margin-inline: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CRO guarantee",
  "presets": [{ "name": "CRO guarantee" }]
}
{% endschema %}
