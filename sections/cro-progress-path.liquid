{% liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif
%}

<section class="cro-path" aria-label="{% if is_ar %}كيف تبدأ{% else %}How it works{% endif %}">
  <div class="cro-path__heading">
    <p class="eyebrow">{% if is_ar %}خطة واضحة{% else %}Simple plan{% endif %}</p>
    <h2>{% if is_ar %}من الحيرة إلى أول خطوة{% else %}From confusion to first action{% endif %}</h2>
  </div>
  <div class="cro-path__steps">
    <article>
      <span>1</span>
      <h3>{% if is_ar %}اختر المسار{% else %}Choose your path{% endif %}</h3>
      <p>{% if is_ar %}حدد هل تبدأ بـ Amazon، دروبشيبينغ، AI، أو الباقة الكاملة.{% else %}Decide between Amazon, dropshipping, AI, or the full bundle.{% endif %}</p>
    </article>
    <article>
      <span>2</span>
      <h3>{% if is_ar %}افتح النظام{% else %}Open the system{% endif %}</h3>
      <p>{% if is_ar %}ابدأ بالقوائم والخطوات العملية من جوالك أو لابتوبك.{% else %}Start with the checklists and action steps from your phone or laptop.{% endif %}</p>
    </article>
    <article class="is-current">
      <span>3</span>
      <h3>{% if is_ar %}نفذ أول اختبار{% else %}Run the first test{% endif %}</h3>
      <p>{% if is_ar %}حوّل الفكرة إلى قرار عملي بدل متابعة فيديوهات أكثر.{% else %}Turn the idea into a practical decision instead of watching more videos.{% endif %}</p>
    </article>
  </div>
</section>

{% stylesheet %}
  .cro-path {
    width: min(var(--page-width), calc(100vw - 2rem));
    margin: 3rem auto;
    padding: 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 8px;
  }

  .cro-path__heading {
    max-width: 680px;
    margin-bottom: 1.5rem;
  }

  .cro-path__heading h2 {
    margin: 0;
    font-family: var(--heading);
    font-size: clamp(2.3rem, 5vw, 4.7rem);
    line-height: 0.92;
    text-transform: uppercase;
  }

  .cro-path__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .cro-path__steps::before {
    content: "";
    position: absolute;
    top: 2rem;
    left: 12%;
    right: 12%;
    height: 3px;
    background: #DCE4EC;
  }

  .cro-path article {
    position: relative;
    padding: 1rem;
    background: #F7F9FB;
    border-radius: 8px;
  }

  .cro-path article.is-current {
    background: var(--color-surface);
    color: #FFFFFF;
  }

  .cro-path span {
    width: 4rem;
    height: 4rem;
    display: grid;
    place-items: center;
    color: #FFFFFF;
    background: #123A6B;
    border: 3px solid #FFFFFF;
    border-radius: 999px;
    font-family: var(--heading);
    font-size: 2rem;
  }

  .cro-path .is-current span {
    background: #123A6B;
  }

  .cro-path h3 {
    margin: 0.8rem 0 0.35rem;
    font-family: var(--heading);
    font-size: clamp(1.5rem, 3vw, 2.3rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .cro-path p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.5;
  }

  .cro-path .is-current p {
    color: rgba(255, 253, 248, 0.82);
  }

  [dir="rtl"] .cro-path__heading h2,
  [dir="rtl"] .cro-path h3,
  [dir="rtl"] .cro-path span {
    font-family: "Cairo", Tahoma, Arial, sans-serif;
    letter-spacing: 0;
    text-transform: none;
  }

  @media (max-width: 760px) {
    .cro-path {
      padding: 1rem;
    }

    .cro-path__steps {
      grid-template-columns: 1fr;
    }

    .cro-path__steps::before {
      top: 2rem;
      bottom: 2rem;
      left: 2rem;
      right: auto;
      width: 3px;
      height: auto;
      background: #DCE4EC;
    }

    [dir="rtl"] .cro-path__steps::before {
      left: auto;
      right: 2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CRO progress path",
  "presets": [{ "name": "CRO progress path" }]
}
{% endschema %}
